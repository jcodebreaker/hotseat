# ElevenLabs API key. Scope it to agents only and set a daily spend cap.
ELEVENLABS_API_KEY=

# Model the voice agent thinks with (any `llm` value ElevenLabs accepts).
HOTSEAT_LLM=claude-sonnet-5-5

# Optional: ElevenLabs voice id. Leave empty for the default voice.
HOTSEAT_VOICE_ID=

# Voice engine: elevenlabs, openai or local. Empty: ElevenLabs when its key is set, otherwise local.
# openai runs the call on OpenAI Realtime. local runs Kokoro (speech) and Whisper (listening) in the
# call window; nothing leaves the machine.
HOTSEAT_ENGINE=

# OpenAI engine only: API key, plus optional model, voice and transcription model.
OPENAI_API_KEY=
HOTSEAT_REALTIME_MODEL=gpt-realtime-2.1
HOTSEAT_REALTIME_VOICE=marin
HOTSEAT_REALTIME_STT_MODEL=gpt-live-transcribe

# Local engine only: Kokoro voice (af_heart, am_michael, bf_emma, ...) and Whisper model.
HOTSEAT_KOKORO_VOICE=
HOTSEAT_STT_MODEL=
